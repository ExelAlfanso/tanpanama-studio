---
// biome-ignore-all lint/suspicious/noUnknownAttribute: Astro templates use native HTML attributes.
import type { Project } from "@tanpanama/contracts";
import { projectListSchema } from "@tanpanama/contracts";
import HomePage from "../components/home/home-page.astro";
import BaseLayout from "../layouts/base-layout.astro";

const apiUrl = import.meta.env.DEV
  ? import.meta.env.PUBLIC_API_URL
  : (await import("cloudflare:workers")).env.PUBLIC_API_URL;
let projects: Project[] = [];
let projectsAvailable = false;

if (apiUrl) {
  try {
    const response = await fetch(new URL("/api/projects", apiUrl));
    if (!response.ok) {
      throw new Error("Project request failed.");
    }
    projects = projectListSchema.parse(await response.json());
    projectsAvailable = true;
  } catch {
    projectsAvailable = false;
  }
}

const featured = projects.find((project) => project.featured);
const otherProjects = projects
  .filter((project) => project.id !== featured?.id)
  .slice(0, 2);
---

<BaseLayout>
  <HomePage
    featured={featured}
    otherProjects={otherProjects}
    projectsAvailable={projectsAvailable}
  />
</BaseLayout>
